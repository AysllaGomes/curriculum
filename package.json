{
  "name": "curriculum",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:pages": "node scripts/fetch-projects.mjs && ng build --configuration production && node scripts/pages-fallback.mjs && node scripts/pdf.mjs",
    "test": "ng test",
    "e2e": "playwright test",
    "projects": "node scripts/fetch-projects.mjs",
    "og": "ng build --configuration production && node scripts/og-images.mjs",
    "pdf": "ng build --configuration production && node scripts/pdf.mjs",
    "lint": "ng lint"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.1"
  }
}
